{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/billewood/popular-film-values-study/schemas/box-office-row.schema.json",
  "title": "Annual popularity frame row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cohort_year",
    "title",
    "stable_title_id",
    "first_domestic_release_date",
    "release_date_precision",
    "release_date_source",
    "source_regime",
    "primary_source_citation",
    "primary_source_url",
    "source_table_year",
    "source_amount_type",
    "metric",
    "territory_definition",
    "amount",
    "amount_estimated",
    "source_row_order",
    "cohort_rank",
    "eligible_rank",
    "reissue_flag",
    "eligibility",
    "exclusion_reason",
    "tie_flag",
    "near_tie_flag",
    "secondary_source_citation",
    "secondary_source_url",
    "secondary_rank",
    "secondary_amount",
    "conflict_code",
    "adjudication_note",
    "retrieved_at_utc",
    "artifact_path",
    "artifact_sha256"
  ],
  "properties": {
    "cohort_year": {"type": "integer", "minimum": 1950, "maximum": 2025},
    "title": {"type": "string", "minLength": 1},
    "stable_title_id": {"type": "string", "minLength": 1},
    "first_domestic_release_date": {"type": "string"},
    "release_date_precision": {"enum": ["day", "month", "year", "inferred", "unresolved"]},
    "release_date_source": {"type": "string", "minLength": 1},
    "source_regime": {"enum": ["variety_rental", "bom_total_gross"]},
    "primary_source_citation": {"type": "string", "minLength": 1},
    "primary_source_url": {"type": "string", "format": "uri"},
    "source_table_year": {"type": "integer", "minimum": 1950},
    "source_amount_type": {"enum": ["projected_ultimate", "cumulative_to_date", "release_run_total"]},
    "metric": {"enum": ["distributor_rental", "domestic_gross"]},
    "territory_definition": {"type": "string", "minLength": 1},
    "amount": {"type": ["number", "null"], "minimum": 0},
    "amount_estimated": {"type": "boolean"},
    "source_row_order": {"type": "integer", "minimum": 1},
    "cohort_rank": {"type": "integer", "minimum": 1},
    "eligible_rank": {"type": ["integer", "null"], "minimum": 1},
    "reissue_flag": {"type": "boolean"},
    "eligibility": {"enum": ["eligible", "ineligible", "unresolved"]},
    "exclusion_reason": {"type": "string"},
    "tie_flag": {"type": "boolean"},
    "near_tie_flag": {"type": "boolean"},
    "secondary_source_citation": {"type": "string"},
    "secondary_source_url": {"type": "string"},
    "secondary_rank": {"type": ["integer", "null"], "minimum": 1},
    "secondary_amount": {"type": ["number", "null"], "minimum": 0},
    "conflict_code": {"type": "string"},
    "adjudication_note": {"type": "string"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "artifact_path": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"}
  }
}
